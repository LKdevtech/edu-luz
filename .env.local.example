# EDU LUZ — system (app webowa)
# Skopiuj do .env.local i uzupełnij. NIE COMMITUJ .env.local.

# Supabase — z dashboardu projektu (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Tylko serwer — klucz service role (nigdy do client komponentów!).
# Używany przez admin/system scripts (migracje, seedowanie z poziomu app).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (powiadomienia email — przypomnienia płatności, odwołania lekcji itd.).
# Klucz API z dashboardu Resend (Settings → API Keys). NIE commituj prawdziwego.
RESEND_API_KEY=re_xxx
# Nadawca maili. Domena musi być zweryfikowana w Resend.
EMAIL_FROM=EDU LUZ <noreply@edu-luz.com>

# Dev-only: ID studenta używanego do testów panelu ucznia przed wpięciem auth.
# W seed: Kacper Nowak = 99999999-0000-0000-0000-000000000030
DEV_STUDENT_ID=99999999-0000-0000-0000-000000000030

# Dev-only: ID rodzica używanego do testów panelu rodzica przed wpięciem auth.
# W seed: Monika Nowak = 99999999-0000-0000-0000-000000000020
DEV_PARENT_ID=99999999-0000-0000-0000-000000000020

# Dev-only: ID korepetytora używanego do testów panelu tutora przed wpięciem auth.
# W seed: Tomasz Kowalski = 99999999-0000-0000-0000-000000000010
DEV_TUTOR_ID=99999999-0000-0000-0000-000000000010

# Dev-only: ID admina używanego do testów panelu admina przed wpięciem auth.
# W seed: Kacper Luchowski (admin) = 99999999-0000-0000-0000-000000000001
DEV_ADMIN_ID=99999999-0000-0000-0000-000000000001
