# EDU LUZ — zmienne środowiskowe.
# Skopiuj do .env.local i uzupełnij (plik .env.local jest ignorowany przez Git).

# --- SEO / metadane ---
# Bazowy adres strony — używany w canonical, sitemap.xml, robots.txt i OpenGraph.
# Na produkcji ustaw na docelową domenę (np. https://edu-luz.com).
NEXT_PUBLIC_SITE_URL=https://edu-luz.com

# --- Formularz kontaktowy (Resend) ---
# Klucz API z https://resend.com (Dashboard → API Keys).
# Bez tej zmiennej formularz zwróci komunikat "nie jest skonfigurowany"
# i nie wyśle maila (reszta strony działa normalnie).
# Adresy nadawcy i odbiorcy są zaszyte w app/(public)/kontakt/actions.ts.
RESEND_API_KEY=
