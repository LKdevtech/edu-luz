# EDU LUZ — zmienne środowiskowe.
# Skopiuj do .env.local i uzupełnij (plik .env.local jest ignorowany przez Git).

# --- Formularz kontaktowy (Resend) ---
# Bez tych zmiennych formularz zwróci komunikat "nie jest skonfigurowany"
# i nie wyśle maila (reszta strony działa normalnie).

# Klucz API z https://resend.com (Dashboard → API Keys):
RESEND_API_KEY=

# Adres, NA KTÓRY mają trafiać wiadomości z formularza (Twoja skrzynka):
CONTACT_TO_EMAIL=

# Adres, Z KTÓREGO wysyłamy. Musi być na zweryfikowanej domenie w Resend
# (np. kontakt@eduluz.pl). Do testów bez własnej domeny użyj: onboarding@resend.dev
CONTACT_FROM_EMAIL=
